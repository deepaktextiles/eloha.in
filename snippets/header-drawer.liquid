  .menu-drawer__badge-dot.is-active {
    width: 18px;
    border-radius: 3px;
    background: var(--badges-dot-color, var(--badges-title-color, #1a1a1a));
  }

  /* Mobile Menu Top Graphic Slider */
  .menu-drawer__graphic-slider-wrapper {
    padding: 0 var(--drawer-padding, 20px) 14px;
    width: 100%;
    box-sizing: border-box;
    position: relative;
  }

  .menu-drawer__graphic-slider {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--drawer-slider-radius, 10px);
  }

  .menu-drawer__graphic-slider::-webkit-scrollbar {
    display: none;
  }

  .menu-drawer__graphic-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    position: relative;
    aspect-ratio: var(--drawer-slider-ratio, 16 / 9);
    border-radius: var(--drawer-slider-radius, 10px);
    overflow: hidden;
    text-decoration: none;
    display: block;
    background: rgba(var(--color-foreground-rgb, 0 0 0) / 0.04);
