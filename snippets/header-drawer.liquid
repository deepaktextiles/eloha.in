  .menu-drawer__graphic-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .menu-drawer__graphic-slide-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
