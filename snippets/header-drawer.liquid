{%- doc -%}
  Renders a header drawer menu triggered by the top details element.

  @param {object} linklist - The linklist to render
  @param {string} [class] - Additional classes to add to the drawer
  @param {string} [data_header_drawer_type] - The type of header drawer to render
  @param {object} [block] - The block that can be used to provide settings
  @param {object} [section] - The section that can be used to provide settings

  @example
  {% render 'header-drawer', linklist: section.settings.menu, class: 'header-drawer--mobile' %}
{%- enddoc -%}

{% render 'summary-icon-styles' %}

{% liquid
  assign block_settings = block.settings
  assign max_featured_items = 4
  assign image_border_radius = block_settings.image_border_radius

  if block_settings.menu_style == 'featured_collections'
    assign ratio = block_settings.featured_collections_aspect_ratio
  elsif block_settings.menu_style == 'featured_products'
    assign ratio = block_settings.featured_products_aspect_ratio
  endif

  ##
  # We only eager load heavy elements of the page when rendering this template
  # through the Section Rendering API.
  #
  # This keeps the initial render lightweight, minimizing the impact on TTFB.
  # The second render then refreshes the page with additional content.
  #
  # At the moment, we check if the Section Rendering API is being used by
  # checking if section.index is blank.
  assign eager_loading = false
  if section.index == blank
    assign eager_loading = true
  endif

  assign drawer_bg = block_settings.drawer_background_color | default: block_settings.background_color
  assign drawer_text = block_settings.drawer_text_color | default: block_settings.text_color

  if drawer_bg != blank or drawer_text != blank
    render 'contrast-override', background_color: drawer_bg, text_color: drawer_text, section_id: block.id
  endif
%}

<script
  src="{{ 'header-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<header-drawer
  class="header-drawer {{ class }}"
  style="--menu-image-border-radius: {{ image_border_radius }}px; --resource-card-corner-radius: {{ image_border_radius }}px;"
>
  <details
    id="Details-menu-drawer-container"
    data-skip-node-update="true"
    class="menu-drawer-container"
    ref="details"
    scroll-lock
  >
    <summary
      class="header__icon header__icon--menu header__icon--summary"
      aria-label="{{ 'accessibility.menu' | t }}"
      on:click="/toggle"
    >
      <span class="svg-wrapper header-drawer-icon header-drawer-icon--open">
        {{- 'icon-menu.svg' | inline_asset_content -}}
      </span>
      <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
        {{- 'icon-close-menu.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div
      ref="menuDrawer"
      class="
        menu-drawer
        {% if drawer_bg != blank or drawer_text != blank %}
          color-custom-{{ block.id }}
        {% endif %}
      "
      style="{% if drawer_bg != blank %}background-color: {{ drawer_bg }};{% endif %}{% if drawer_text != blank %}color: {{ drawer_text }};{% endif %}"
    >
      <button
        class="button close-button menu-drawer__close-button focus-inset"
        type="button"
        aria-label="{{ 'actions.close' | t }}"
        on:click="/close"
      >
        <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
          {{- 'icon-close-menu.svg' | inline_asset_content -}}
        </span>
      </button>

      {%- comment -%} Mobile Menu Top Graphic / Image Slider {%- endcomment -%}
      {%- liquid
        assign show_top_slider = block_settings.show_drawer_slider
        if show_top_slider == nil
          assign show_top_slider = true
        endif

        assign slide_count = 0
        if block_settings.drawer_slide1_image != blank
          assign slide_count = slide_count | plus: 1
        endif
        if block_settings.drawer_slide2_image != blank
          assign slide_count = slide_count | plus: 1
        endif
        if block_settings.drawer_slide3_image != blank
          assign slide_count = slide_count | plus: 1
        endif
        if block_settings.drawer_slide4_image != blank
          assign slide_count = slide_count | plus: 1
        endif
      -%}

      {%- if show_top_slider -%}
        {%- if slide_count > 0 or request.design_mode -%}
          {%- liquid
            assign slider_ratio = block_settings.drawer_slider_aspect_ratio | default: '16 / 9'
            assign slider_radius = block_settings.drawer_slider_border_radius | default: 10
            assign slider_dot_color = block_settings.drawer_slider_dot_color | default: '#1A1A1A'
            assign slider_text_color = block_settings.drawer_slider_text_color | default: '#FFFFFF'
            assign autoplay_interval = block_settings.drawer_slider_interval | default: 4 | times: 1000
            assign autoplay_enabled = block_settings.drawer_slider_autoplay
            if autoplay_enabled == nil
              assign autoplay_enabled = true
            endif
          -%}

          <div
            class="menu-drawer__graphic-slider-wrapper"
            style="
              --drawer-slider-ratio: {{ slider_ratio }};
              --drawer-slider-radius: {{ slider_radius }}px;
              --drawer-slider-dot: {{ slider_dot_color }};
              --drawer-slider-text: {{ slider_text_color }};
            "
          >
            <div
              class="menu-drawer__graphic-slider"
              id="menuDrawerGraphicSlider"
              data-autoplay="{{ autoplay_enabled }}"
              data-interval="{{ autoplay_interval }}"
            >
              {%- if slide_count == 0 and request.design_mode -%}
                <div class="menu-drawer__graphic-slide" data-index="0">
                  <div class="menu-drawer__graphic-slide-placeholder">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                    <span><strong>Add Graphic Slides</strong><br>In Customizer → Header → Header Menu</span>
                  </div>
                </div>
              {%- else -%}
                {%- assign current_slide_idx = 0 -%}

                {%- if block_settings.drawer_slide1_image != blank -%}
                  {%- if block_settings.drawer_slide1_link != blank -%}
                    <a href="{{ block_settings.drawer_slide1_link }}" class="menu-drawer__graphic-slide" data-index="{{ current_slide_idx }}">
                  {%- else -%}
                    <div class="menu-drawer__graphic-slide" data-index="{{ current_slide_idx }}">
                  {%- endif -%}
                    {{ block_settings.drawer_slide1_image | image_url: width: 800 | image_tag: class: 'menu-drawer__graphic-img', loading: 'lazy' }}
                    {%- if block_settings.drawer_slide1_heading != blank or block_settings.drawer_slide1_subheading != blank -%}
                      <div class="menu-drawer__graphic-caption">
                        {%- if block_settings.drawer_slide1_heading != blank -%}
                          <span class="menu-drawer__graphic-title">{{ block_settings.drawer_slide1_heading }}</span>
                        {%- endif -%}
                        {%- if block_settings.drawer_slide1_subheading != blank -%}
                          <span class="menu-drawer__graphic-subtitle">{{ block_settings.drawer_slide1_subheading }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- if block_settings.drawer_slide1_link != blank -%}
                    </a>
                  {%- else -%}
                    </div>
                  {%- endif -%}
                  {%- assign current_slide_idx = current_slide_idx | plus: 1 -%}
                {%- endif -%}

                {%- if block_settings.drawer_slide2_image != blank -%}
                  {%- if block_settings.drawer_slide2_link != blank -%}
                    <a href="{{ block_settings.drawer_slide2_link }}" class="menu-drawer__graphic-slide" data-index="{{ current_slide_idx }}">
                  {%- else -%}
                    <div class="menu-drawer__graphic-slide" data-index="{{ current_slide_idx }}">
                  {%- endif -%}
                    {{ block_settings.drawer_slide2_image | image_url: width: 800 | image_tag: class: 'menu-drawer__graphic-img', loading: 'lazy' }}
                    {%- if block_settings.drawer_slide2_heading != blank or block_settings.drawer_slide2_subheading != blank -%}
                      <div class="menu-drawer__graphic-caption">
                        {%- if block_settings.drawer_slide2_heading != blank -%}
                          <span class="menu-drawer__graphic-title">{{ block_settings.drawer_slide2_heading }}</span>
                        {%- endif -%}
                        {%- if block_settings.drawer_slide2_subheading != blank -%}
                          <span class="menu-drawer__graphic-subtitle">{{ block_settings.drawer_slide2_subheading }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- if block_settings.drawer_slide2_link != blank -%}
                    </a>
                  {%- else -%}
                    </div>
                  {%- endif -%}
                  {%- assign current_slide_idx = current_slide_idx | plus: 1 -%}
                {%- endif -%}

                {%- if block_settings.drawer_slide3_image != blank -%}
                  {%- if block_settings.drawer_slide3_link != blank -%}
                    <a href="{{ block_settings.drawer_slide3_link }}" class="menu-drawer__graphic-slide" data-index="{{ current_slide_idx }}">
                  {%- else -%}
                    <div class="menu-drawer__graphic-slide" data-index="{{ current_slide_idx }}">
                  {%- endif -%}
                    {{ block_settings.drawer_slide3_image | image_url: width: 800 | image_tag: class: 'menu-drawer__graphic-img', loading: 'lazy' }}
                    {%- if block_settings.drawer_slide3_heading != blank or block_settings.drawer_slide3_subheading != blank -%}
                      <div class="menu-drawer__graphic-caption">
                        {%- if block_settings.drawer_slide3_heading != blank -%}
                          <span class="menu-drawer__graphic-title">{{ block_settings.drawer_slide3_heading }}</span>
                        {%- endif -%}
                        {%- if block_settings.drawer_slide3_subheading != blank -%}
                          <span class="menu-drawer__graphic-subtitle">{{ block_settings.drawer_slide3_subheading }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- if block_settings.drawer_slide3_link != blank -%}
                    </a>
                  {%- else -%}
                    </div>
                  {%- endif -%}
                  {%- assign current_slide_idx = current_slide_idx | plus: 1 -%}
                {%- endif -%}

                {%- if block_settings.drawer_slide4_image != blank -%}
                  {%- if block_settings.drawer_slide4_link != blank -%}
                    <a href="{{ block_settings.drawer_slide4_link }}" class="menu-drawer__graphic-slide" data-index="{{ current_slide_idx }}">
                  {%- else -%}
                    <div class="menu-drawer__graphic-slide" data-index="{{ current_slide_idx }}">
                  {%- endif -%}
                    {{ block_settings.drawer_slide4_image | image_url: width: 800 | image_tag: class: 'menu-drawer__graphic-img', loading: 'lazy' }}
                    {%- if block_settings.drawer_slide4_heading != blank or block_settings.drawer_slide4_subheading != blank -%}
                      <div class="menu-drawer__graphic-caption">
                        {%- if block_settings.drawer_slide4_heading != blank -%}
                          <span class="menu-drawer__graphic-title">{{ block_settings.drawer_slide4_heading }}</span>
                        {%- endif -%}
                        {%- if block_settings.drawer_slide4_subheading != blank -%}
                          <span class="menu-drawer__graphic-subtitle">{{ block_settings.drawer_slide4_subheading }}</span>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                  {%- if block_settings.drawer_slide4_link != blank -%}
                    </a>
                  {%- else -%}
                    </div>
                  {%- endif -%}
                  {%- assign current_slide_idx = current_slide_idx | plus: 1 -%}
                {%- endif -%}
              {%- endif -%}
            </div>

            {%- if slide_count > 1 -%}
              <div class="menu-drawer__graphic-dots" id="menuDrawerGraphicDots">
                {%- for i in (1..slide_count) -%}
                  <button type="button" class="menu-drawer__graphic-dot{% if forloop.first %} is-active{% endif %}" data-dot="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endif -%}
      <nav
        class="menu-drawer__navigation"
        style="
          {%- render 'menu-font-styles', settings: block_settings, menu_type: 'drawer' %}
          {%- render 'submenu-font-styles', settings: block_settings %}
        "
        aria-label="{{ 'accessibility.header_navigation_label' | t }}"
      >
        <ul
          class="menu-drawer__menu has-submenu"
          role="list"
        >
          {%- comment -%}
            Handle menus with fewer than 3 levels of links
          {%- endcomment -%}
          {% if linklist.levels < 3 %}
            {% assign first_accordion_open = false %}
            {% assign animation_index = 0 %}
            {%- for link in linklist.links -%}
              {% assign animation_index = animation_index | plus: 1 %}
              <li
                style="--menu-drawer-animation-index: {{ animation_index }};"
                class="{%- if block_settings.drawer_accordion -%}menu-drawer__list-item--deep{%- else -%}menu-drawer__list-item--flat{%- endif -%}{% if block_settings.drawer_dividers %} menu-drawer__list-item--divider{% endif %}"
              >
                {% if block_settings.drawer_accordion and link.links != blank %}
                  {%- comment -%}
                    Accordion for links with children, in menus with fewer than 3 levels of links
                  {%- endcomment -%}
                  {% liquid
                    assign should_open_first = false
                    if first_accordion_open == false and block_settings.drawer_accordion_expand_first
                      assign first_accordion_open = true
                      assign should_open_first = true
                    endif
                  %}
                  {% capture accordion_children %}
                    <details
                      id="Details-menu-drawer-{{ link.handle }}"
                    >
                      <summary
                        id="HeaderDrawer-{{ link.handle }}"
                        class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element"
                      >
                        <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                        <span class="svg-wrapper icon-plus">
                          {{- 'icon-plus.svg' | inline_asset_content -}}
                        </span>
                      </summary>
                      {% liquid
                        assign render_link_image = false
                        if block_settings.menu_style == 'collection_images'
                          assign catalog_links = link.links | where: 'type', 'catalog_link'
                          assign collection_list_links = link.links | where: 'type', 'collections_link'
                          assign collection_links = link.links | where: 'type', 'collection_link'
                          if catalog_links.size > 0 or collection_list_links.size > 0 or collection_links.size > 0
                            assign render_link_image = true
                          endif
                        endif
                      %}
                      <ul
                        class="menu-drawer__menu menu-drawer__menu--childlist menu-drawer__animated-element details-content{% if render_link_image %} menu-drawer__menu--grid{% endif %}"
                        role="list"
                        tabindex="-1"
                      >
                        {%- for childlink in link.links -%}
                          <li
                            class="menu-drawer__list-item"
                            style="--menu-drawer-animation-index: {{ forloop.index }};"
                          >
                            <a
                              id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                              href="{{ childlink.url }}"
                              class="menu-drawer__menu-item menu-drawer__menu-item--child{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                              {% if childlink.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              {% if render_link_image %}
                                {% render 'link-featured-image',
                                  link: childlink,
                                  class: 'menu-drawer__link-image',
                                  sizes: 'auto, 400px'
                                %}
                              {% endif %}
                              <span class="menu-drawer__menu-item-text wrap-text">{{ childlink.title | escape }}</span>
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </details>
                  {% endcapture %}
                  {% render 'accordion-custom-component',
                    children: accordion_children,
                    open_by_default_on_mobile: should_open_first
                  %}
                {% elsif block_settings.drawer_accordion == false and link.links != blank %}
                  {%- comment -%}
                    Flat menus for links with children, in menus with fewer than 3 levels of links
                  {%- endcomment -%}
                  <a
                    id="HeaderDrawer-{{ link.handle }}"
                    href="{{ link.url }}"
                    class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                  </a>
                  {% liquid
                    assign render_link_image = false
                    if block_settings.menu_style == 'collection_images'
                      assign catalog_links = link.links | where: 'type', 'catalog_link'
                      assign collection_list_links = link.links | where: 'type', 'collections_link'
                      assign collection_links = link.links | where: 'type', 'collection_link'
                      if catalog_links.size > 0 or collection_list_links.size > 0 or collection_links.size > 0
                        assign render_link_image = true
                      endif
                    endif
                  %}
                  <ul
                    class="menu-drawer__menu menu-drawer__menu--childlist{% if render_link_image %} menu-drawer__menu--grid{% endif %}"
                    role="list"
                    tabindex="-1"
                  >
                    {%- for childlink in link.links -%}
                      <li
                        class="menu-drawer__list-item"
                        style="--menu-drawer-animation-index: {{ animation_index }};"
                      >
                        <a
                          href="{{ childlink.url }}"
                          class="menu-drawer__menu-item menu-drawer__menu-item--child menu-drawer__animated-element{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                          {% if childlink.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {% if render_link_image %}
                            {% render 'link-featured-image',
                              link: childlink,
                              class: 'menu-drawer__link-image',
                              sizes: 'auto, 400px'
                            %}
                          {% endif %}
                          <span class="menu-drawer__menu-item-text wrap-text">{{ childlink.title | escape }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {% else %}
                  {%- comment -%}
                    Simple links for links with no children (regardless of accordion setting), in menus with fewer than 3 levels of links
                  {%- endcomment -%}
                  <a
                    id="HeaderDrawer-{{ link.handle }}"
                    href="{{ link.url }}"
                    class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                  </a>
                {% endif %}
              </li>
            {%- endfor -%}
          {% else %}
            {%- comment -%}
              Handle menus with 3 levels of links
            {%- endcomment -%}
            {% assign animation_index = 0 %}
            {%- for link in linklist.links -%}
              {% assign animation_index = animation_index | plus: 1 %}
              <li
                class="menu-drawer__list-item"
                style="--menu-drawer-animation-index: {{ animation_index }};"
              >
                {%- if link.links != blank -%}
                  {%- comment -%}
                    Regardless of the Accordion setting, in menus with 3 levels of links, we use a details element to handle the top level of the menu for links that have children.
                  {%- endcomment -%}
                  <details
                    id="Details-menu-drawer-menu-item-{{ forloop.index }}"
                    class="menu-drawer__menu-container{% if block_settings.drawer_dividers %} menu-drawer__menu-container--divider{% endif %}"
                  >
                    <summary
                      id="HeaderDrawer-{{ link.handle }}"
                      class="menu-drawer__menu-item menu-drawer__menu-item--mainlist menu-drawer__animated-element{% if link.child_active %} menu-drawer__menu-item--active{% endif %}"
                      on:click="header-drawer/open/submenu"
                    >
                      <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                      <span class="svg-wrapper icon-caret icon-caret--forward">
                        {{- 'icon-caret.svg' | inline_asset_content -}}
                      </span>
                    </summary>
                    <div
                      id="link-{{ link.handle | escape }}"
                      class="menu-drawer__submenu has-submenu"
                      tabindex="-1"
                      style="--menu-drawer-animation-index: {{ animation_index }};"
                    >
                      <div class="menu-drawer__inner-submenu">
                        <div class="menu-drawer__nav-buttons menu-drawer__nav-buttons--with-title">
                          <button
                            class="button menu-drawer__back-button focus-inset"
                            on:click="header-drawer/back"
                            aria-label="{{ 'actions.back_to_main_menu' | t }}"
                          >
                            <span class="svg-wrapper icon-caret icon-caret--backward">
                              {{- 'icon-caret.svg' | inline_asset_content -}}
                            </span>
                          </button>
                          <a
                            href="{{ link.url }}"
                            class="menu-drawer__title focus-inset"
                            {% if link.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                          </a>
                          <button
                            class="button button-unstyled close-button menu-drawer__close-button focus-inset"
                            type="button"
                            aria-label="{{ 'actions.close' | t }}"
                            on:click="header-drawer/close"
                          >
                            <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
                              {{- 'icon-close-menu.svg' | inline_asset_content -}}
                            </span>
                          </button>
                        </div>
                        {% liquid
                          assign render_link_image = false
                          if block_settings.menu_style == 'collection_images'
                            assign catalog_links = link.links | where: 'type', 'catalog_link'
                            assign collection_list_links = link.links | where: 'type', 'collections_link'
                            assign collection_links = link.links | where: 'type', 'collection_link'
                            if catalog_links.size > 0 or collection_list_links.size > 0 or collection_links.size > 0
                              assign render_link_image = true
                            endif
                          endif
                        %}
                        <ul
                          class="menu-drawer__menu menu-drawer__menu--childlist{% if render_link_image and link.levels == 1 %} menu-drawer__menu--grid{% endif %}"
                          role="list"
                          tabindex="-1"
                        >
                          {% assign first_accordion_open = false -%}
                          {%- for childlink in link.links -%}
                            <li
                              class="
                                menu-drawer__list-item
                                {% if childlink.links != blank -%}
                                  {% if block_settings.drawer_accordion -%} menu-drawer__list-item--deep{% else -%} menu-drawer__list-item--flat{%- endif -%}
                                {%- endif -%}
                                {% if block_settings.drawer_dividers %} menu-drawer__list-item--divider{% endif %}
                              "
                            >
                              {%- if childlink.links == blank -%}
                                {%- comment -%}
                                  Simple links for links with no children (regardless of accordion setting), in menus with 3 levels of links
                                  This link is currently using --parent class style but --child would match the pattern on desktop
                                {%- endcomment -%}
                                <a
                                  id="HeaderDrawer-{{ link.handle }}-{{ childlink.handle }}"
                                  href="{{ childlink.url }}"
                                  class="menu-drawer__menu-item menu-drawer__menu-item--parent{% if childlink.current %} menu-drawer__menu-item--active{% endif %}"
                                  {% if childlink.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {% if render_link_image and link.levels == 1 %}
                                    {% render 'link-featured-image',
                                      link: childlink,
                                      class: 'menu-drawer__link-image',
                                      sizes: 'auto, 400px'
                                    %}
                                  {% endif %}
                                  <span class="menu-drawer__menu-item-text wrap-text">
                                    {{- childlink.title | escape -}}
                                  </span>
                                </a>
                              {%- else -%}
                                {% liquid
                                  assign should_open_first_nested = false
                                  if first_accordion_open == false and block_settings.drawer_accordion and block_settings.drawer_accordion_expand_first
                                    assign first_accordion_open = true
                                    assign should_open_first_nested = true
                                  endif
                                %}
                                {% if block_settings.drawer_accordion %}
                                  {%- comment -%}
                                    Accordion for links with children, in menus with 3 levels of links
                                  {%- endcomment -%}
                                  {% capture accordion_children_nested %}
                                    <details
                                      id="Details-menu-drawer-{{ link.handle }}-{{ childlink.handle }}"
                                    >
                                      <summary
