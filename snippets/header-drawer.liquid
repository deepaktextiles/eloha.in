  .menu-drawer__bottom-account-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--drawer-account-icon, #e69a10);
  }

  .menu-drawer__bottom-account-icon svg {
    display: block;
    width: 18px;
    height: 18px;
  }

  .menu-drawer__bottom-socials {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .menu-drawer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--drawer-social-icon, #1a1a1a);
    transition: transform 0.2s ease, opacity 0.2s ease;
    text-decoration: none;
  }

  .menu-drawer__social-link:hover {
    opacity: 0.7;
    transform: translateY(-1px);
  }

  .menu-drawer__social-link svg {
    display: block;
    width: 20px;
    height: 20px;
  }
{% endstylesheet %}
