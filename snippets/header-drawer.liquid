      <script>
        (function() {
          function initDrawerBadgesCarousel() {
            var carousel = document.getElementById('menuDrawerBadgesCarousel');
            var dotsContainer = document.getElementById('menuDrawerBadgeDots');
            if (!carousel || !dotsContainer) return;

            var dots = dotsContainer.querySelectorAll('.menu-drawer__badge-dot');
            var cards = carousel.querySelectorAll('.menu-drawer__badge-card');
            if (!cards.length) return;

            var currentIndex = 0;
            var timer = null;
            var isInteracting = false;

            function updateActiveDot(index) {
              dots.forEach(function(dot, i) {
                dot.classList.toggle('is-active', i === index);
              });
            }

            function scrollToCard(index) {
              if (!cards[index]) return;
              currentIndex = index;
              var targetLeft = cards[index].offsetLeft - carousel.offsetLeft;
              carousel.scrollTo({
                left: targetLeft,
                behavior: 'smooth'
              });
              updateActiveDot(index);
            }

            function nextSlide() {
              if (isInteracting) return;
              currentIndex = (currentIndex + 1) % cards.length;
              scrollToCard(currentIndex);
            }

            function startTimer() {
              stopTimer();
              timer = setInterval(nextSlide, 3500);
            }

            function stopTimer() {
              if (timer) clearInterval(timer);
            }

            carousel.addEventListener('scroll', function() {
              var scrollLeft = carousel.scrollLeft;
              var closestIndex = 0;
              var minDiff = Infinity;
              cards.forEach(function(card, i) {
                var diff = Math.abs(card.offsetLeft - carousel.offsetLeft - scrollLeft);
                if (diff < minDiff) {
                  minDiff = diff;
                  closestIndex = i;
                }
              });
              currentIndex = closestIndex;
              updateActiveDot(closestIndex);
            }, { passive: true });

            carousel.addEventListener('touchstart', function() {
              isInteracting = true;
              stopTimer();
            }, { passive: true });

            carousel.addEventListener('touchend', function() {
              isInteracting = false;
              startTimer();
            }, { passive: true });

            dots.forEach(function(dot, i) {
              dot.addEventListener('click', function() {
                scrollToCard(i);
                startTimer();
              });
            });

            startTimer();
          }

          function initDrawerGraphicSlider() {
            var slider = document.getElementById('menuDrawerGraphicSlider');
            var dotsContainer = document.getElementById('menuDrawerGraphicDots');
            if (!slider) return;

            var dots = dotsContainer ? dotsContainer.querySelectorAll('.menu-drawer__graphic-dot') : [];
            var slides = slider.querySelectorAll('.menu-drawer__graphic-slide');
            if (slides.length <= 1) return;

            var currentIndex = 0;
            var isInteracting = false;
            var autoplay = slider.getAttribute('data-autoplay') === 'true';
            var interval = parseInt(slider.getAttribute('data-interval'), 10) || 4000;
            var timer = null;

            function updateActiveDot(idx) {
              if (!dots.length) return;
              dots.forEach(function(dot, i) {
                if (i === idx) {
                  dot.classList.add('is-active');
                } else {
                  dot.classList.remove('is-active');
                }
              });
            }

            function scrollToSlide(idx) {
              if (idx < 0 || idx >= slides.length) return;
              var targetSlide = slides[idx];
              slider.scrollTo({
                left: targetSlide.offsetLeft - slider.offsetLeft,
                behavior: 'smooth'
              });
              currentIndex = idx;
              updateActiveDot(idx);
            }

            function startTimer() {
              if (!autoplay || isInteracting || slides.length <= 1) return;
              stopTimer();
              timer = setInterval(function() {
                currentIndex = (currentIndex + 1) % slides.length;
                scrollToSlide(currentIndex);
              }, interval);
            }

            function stopTimer() {
              if (timer) clearInterval(timer);
            }

            slider.addEventListener('scroll', function() {
              var scrollLeft = slider.scrollLeft;
              var closestIndex = 0;
              var minDiff = Infinity;
              slides.forEach(function(slide, i) {
                var diff = Math.abs(slide.offsetLeft - slider.offsetLeft - scrollLeft);
                if (diff < minDiff) {
                  minDiff = diff;
                  closestIndex = i;
                }
              });
              currentIndex = closestIndex;
              updateActiveDot(closestIndex);
            }, { passive: true });

            slider.addEventListener('touchstart', function() {
              isInteracting = true;
              stopTimer();
            }, { passive: true });

            slider.addEventListener('touchend', function() {
              isInteracting = false;
              startTimer();
            }, { passive: true });

            dots.forEach(function(dot, i) {
              dot.addEventListener('click', function() {
                scrollToSlide(i);
                startTimer();
              });
            });

            startTimer();
          }

          if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() {
              initDrawerBadgesCarousel();
              initDrawerGraphicSlider();
            });
          } else {
            initDrawerBadgesCarousel();
            initDrawerGraphicSlider();
          }
        })();
      </script>
