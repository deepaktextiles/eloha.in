<div
  id="CustomImageCards-{{ section.id }}"
  class="custom-cards-section"
  style="
    --section-card-btn-bg: {{ section.settings.btn_bg_color | default: '#000000' }};
    --section-card-btn-text: {{ section.settings.btn_text_color | default: '#ffffff' }};
    --section-card-btn-border: {{ section.settings.btn_border_color | default: section.settings.btn_bg_color | default: '#000000' }};
    --section-card-btn-hover-bg: {{ section.settings.btn_hover_bg_color | default: 'transparent' }};
    --section-card-btn-hover-text: {{ section.settings.btn_hover_text_color | default: '#000000' }};
    --section-card-btn-hover-border: {{ section.settings.btn_hover_border_color | default: section.settings.btn_border_color | default: '#000000' }};
    --card-btn-wrap-bg: {{ section.settings.card_button_wrap_bg | default: '#ffffff' }};
  "
>
  <div class="section">

    {% if section.settings.heading != blank or section.settings.paragraph != blank %}
      <div class="custom-cards-heading">
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.paragraph != blank %}
          <p class="custom-cards-subtext">{{ section.settings.paragraph }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="custom-cards-wrapper">
      <div class="swiper custom-cards-swiper" id="custom-cards-swiper-{{ section.id }}">
        <div class="swiper-wrapper custom-cards-track">

          {% for block in section.blocks %}
            <div class="swiper-slide custom-card" {{ block.shopify_attributes }}>
              <div class="card-inner">
                {% if block.settings.image %}
                  {% if block.settings.card_link != blank %}
                    <a href="{{ block.settings.card_link }}">
                  {% endif %}

                  <img
                    src="{{ block.settings.image | image_url: width: 800 }}"
                    alt="{{ block.settings.image.alt | escape }}"
                    loading="lazy"
                  >

                  {% if block.settings.card_link != blank %}
                    </a>
                  {% endif %}
                {% endif %}

                {% if block.settings.button_text != blank %}
                  <div class="card-button-wrap">
                    {% if block.settings.card_link != blank %}
                      <a
                        href="{{ block.settings.card_link }}"
                        class="card-btn"
                        style="
                          {% if block.settings.btn_bg_color != blank %}--card-btn-bg: {{ block.settings.btn_bg_color }};{% endif %}
                          {% if block.settings.btn_text_color != blank %}--card-btn-text: {{ block.settings.btn_text_color }};{% endif %}
                          {% if block.settings.btn_border_color != blank %}--card-btn-border: {{ block.settings.btn_border_color }};{% endif %}
                        "
                      >
                        {{ block.settings.button_text }}
                      </a>
                    {% else %}
                      <span
                        class="card-btn"
                        style="
                          {% if block.settings.btn_bg_color != blank %}--card-btn-bg: {{ block.settings.btn_bg_color }};{% endif %}
                          {% if block.settings.btn_text_color != blank %}--card-btn-text: {{ block.settings.btn_text_color }};{% endif %}
                          {% if block.settings.btn_border_color != blank %}--card-btn-border: {{ block.settings.btn_border_color }};{% endif %}
                        "
                      >
                        {{ block.settings.button_text }}
                      </span>
                    {% endif %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% endfor %}

        </div>
      </div>

      {%- assign show_arrows = section.settings.show_arrows -%}
      {%- if show_arrows == nil -%}
        {%- assign show_arrows = true -%}
      {%- endif -%}

      {%- if show_arrows and section.blocks.size > 1 -%}
        <!-- Swiper Navigation Arrows -->
        <button
          type="button"
          class="custom-cards-nav custom-cards-nav--prev"
          id="custom-cards-prev-{{ section.id }}"
          aria-label="Previous card"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        <button
          type="button"
          class="custom-cards-nav custom-cards-nav--next"
          id="custom-cards-next-{{ section.id }}"
          aria-label="Next card"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      {%- endif -%}
    </div>

  </div>
</div>

<style>
.custom-cards-section {
  padding: 50px 0;
  background: #fdfbf9;
  position: relative;
}

.custom-cards-section .page-width {
  max-width: 1440px !important;
  margin: 0 auto;
  padding: 0 24px;
}

.custom-cards-wrapper {
  width: 100%;
  position: relative;
}

.custom-cards-swiper {
  width: 100%;
  overflow: hidden;
  padding: 8px 4px 16px 4px;
}

.custom-cards-track {
  display: flex;
  box-sizing: border-box;
}

.custom-card.swiper-slide {
  height: auto;
  flex-shrink: 0;
  box-sizing: border-box;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
  border-radius: 12px;
  overflow: hidden;
}

.card-inner {
  overflow: hidden;
  background: #fff;
  display: flex;
  flex-direction: column;
  height: 100%;
  border: 1px solid #eae5df;
  border-radius: 12px;
}

.card-inner a {
  display: block;
  overflow: hidden;
}

.card-inner img {
  width: 100%;
  height: auto;
  display: block;
  transition: transform 0.5s ease;
}

/* Zoom effect on image hover */
.custom-card:hover img {
  transform: scale(1.01);
}

.custom-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 20px rgba(30, 77, 58, 0.08);
}

/* Bottom button styling */
#CustomImageCards-{{ section.id }} .card-button-wrap {
  text-align: center;
 
  background: var(--card-btn-wrap-bg, #ffffff);
  margin-top: auto;
}

#CustomImageCards-{{ section.id }} .card-btn {
  display: inline-block;
  width: 100%;
  padding: 12px 24px;
  background: var(--card-btn-bg, var(--section-card-btn-bg, #000000));
  color: var(--card-btn-text, var(--section-card-btn-text, #ffffff));
  font-size: 13px;
  font-weight: 600;
  text-decoration: none;
  border-radius: 4px;
  transition: all 0.3s ease;
  cursor: pointer;
  border: 1px solid var(--card-btn-border, var(--section-card-btn-border, #000000));
  text-transform: uppercase;
  letter-spacing: 1px;
}

#CustomImageCards-{{ section.id }} .card-btn:hover {
  background: var(--section-card-btn-hover-bg, transparent);
  color: var(--section-card-btn-hover-text, #000000);
  border-color: var(--section-card-btn-hover-border, #000000);
  letter-spacing: 1.5px;
}

/* Navigation Arrows */
.custom-cards-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #ffffff;
  color: #1a1a1a;
  border: 1px solid #e2ddd8;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  transition: all 0.25s ease;
  padding: 0;
}

.custom-cards-nav svg {
  display: block;
}

.custom-cards-nav--prev {
  left: -20px;
}

.custom-cards-nav--next {
  right: -20px;
}

.custom-cards-nav:hover {
  background: #000000;
  color: #ffffff;
  border-color: #000000;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.15);
}

.custom-cards-nav.swiper-button-disabled {
  opacity: 0.3;
  cursor: not-allowed;
  pointer-events: none;
}

@media (max-width: 900px) {
  .custom-cards-nav--prev {
    left: 2px;
  }
  .custom-cards-nav--next {
    right: 2px;
  }
}

@media (max-width: 767px) {
  .custom-cards-section {
    padding: 28px 0;
  }

  .custom-cards-section .page-width {
    padding: 0 16px;
  }

  .custom-cards-nav {
    display: none;
  }

  .custom-card:hover {
    transform: none;
  }
}

.custom-cards-heading {
  text-align: center;
  margin-bottom: 35px;
}

.custom-cards-heading h2 {
  font-size: clamp(24px, 3.5vw, 36px);
  font-weight: 700;
  line-height: 1.3;
  margin: 0 0 12px;
  color: #000000cf;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.custom-cards-subtext {
  font-size: clamp(14px, 1.6vw, 20px);
  color: #000000;
  line-height: 1.7;
  margin: 0 auto;
}

@media (max-width: 767px) {
  .custom-cards-heading {
    margin-bottom: 20px;
    padding: 0 16px;
  }
}
</style>

<script>
  (function () {
    function initCustomCardsSlider() {
      var sectionId = '{{ section.id }}';
      var swiperEl = document.getElementById('custom-cards-swiper-' + sectionId);
      if (!swiperEl) return;

      if (typeof Swiper === 'undefined') {
        setTimeout(initCustomCardsSlider, 100);
        return;
      }

      if (swiperEl.swiper) {
        swiperEl.swiper.destroy(true, true);
      }

      var autoplaySetting = {{ section.settings.autoplay | default: false }};
      var autoplayConfig = false;
      if (autoplaySetting) {
        autoplayConfig = {
          delay: {{ section.settings.autoplay_speed | default: 4 | times: 1000 }},
          disableOnInteraction: false,
          pauseOnMouseEnter: true
        };
      }

      var desktopCols = {{ section.settings.columns_desktop | default: 5 }};
      var tabletCols = {{ section.settings.columns_tablet | default: 3 }};
      var mobileCols = parseFloat('{{ section.settings.columns_mobile | default: "1.15" }}') || 1.15;

      new Swiper(swiperEl, {
        slidesPerView: mobileCols,
        spaceBetween: 14,
        grabCursor: true,
        watchOverflow: true,
        loop: {{ section.settings.enable_loop | default: false }},
        autoplay: autoplayConfig,
        navigation: {
          prevEl: '#custom-cards-prev-' + sectionId,
          nextEl: '#custom-cards-next-' + sectionId
        },
        breakpoints: {
          480: {
            slidesPerView: Math.min(mobileCols + 0.3, 2),
            spaceBetween: 16
          },
          640: {
            slidesPerView: 2.1,
            spaceBetween: 18
          },
          768: {
            slidesPerView: tabletCols,
            spaceBetween: 20
          },
          1024: {
            slidesPerView: desktopCols,
            spaceBetween: 20
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCustomCardsSlider);
    } else {
      initCustomCardsSlider();
    }

    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail && e.detail.sectionId === '{{ section.id }}') {
        initCustomCardsSlider();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Custom Image Cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Choose Eloha"
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph (below heading)"
    },
    {
      "type": "header",
      "content": "Carousel Settings"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Cards visible on Desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Cards visible on Tablet",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Cards visible on Mobile",
      "options": [
        { "value": "1.15", "label": "1 Card (with peek)" },
        { "value": "1.4", "label": "1.5 Cards" },
        { "value": "2", "label": "2 Cards" },
        { "value": "2.2", "label": "2 Cards (with peek)" }
      ],
      "default": "1.15"
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show Navigation Arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable Autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed (seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "enable_loop",
      "label": "Loop Carousel",
      "default": false
    },
    {
      "type": "header",
      "content": "Button Colors"
    },
    {
      "type": "color",
      "id": "btn_bg_color",
      "label": "Button Background Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Button Text Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "btn_border_color",
      "label": "Button Border Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_hover_bg_color",
      "label": "Button Hover Background Color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "btn_hover_text_color",
      "label": "Button Hover Text Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "btn_hover_border_color",
      "label": "Button Hover Border Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_button_wrap_bg",
      "label": "Button Container Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card Image"
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Card Link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "header",
          "content": "Button Colors (Optional Override)"
        },
        {
          "type": "color",
          "id": "btn_bg_color",
          "label": "Button Background Color"
        },
        {
          "type": "color",
          "id": "btn_text_color",
          "label": "Button Text Color"
        },
        {
          "type": "color",
          "id": "btn_border_color",
          "label": "Button Border Color"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Image Cards"
    }
  ]
}
{% endschema %}
