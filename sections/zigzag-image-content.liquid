{% comment %}
  Section contract.
  Renders an optional centered or aligned intro header followed by alternating
  zig-zag rows of image and content blocks for brand storytelling pages.
  @example
  <!-- Add the "Zigzag image content" section to a page template in the theme editor -->
{% endcomment %}

{% liquid
  if section.settings.background_color != blank or section.settings.text_color != blank
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
  endif

  assign has_header = false
  if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank
    assign has_header = true
  endif
%}

<div
  class="section-background{% if section.settings.background_color != blank or section.settings.text_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank or section.settings.text_color != blank %} color-custom-{{ section.id }}{% endif %} spacing-style zigzag-section"
  id="ZigzagContent-{{ section.id }}"
  style="
    {%- render 'spacing-style', settings: section.settings %}
    --zigzag-row-gap: {{ section.settings.row_gap }}px;
    --zigzag-col-gap: {{ section.settings.column_gap }}px;
    --zigzag-image-radius: {{ section.settings.image_corner_radius }}px;
  "
>
  <div class="zigzag-section__inner{% if section.settings.section_width == 'full-width' %} zigzag-section__inner--full-padded{% endif %}">
    {%- if has_header -%}
      <header class="zigzag-section__header zigzag-section__header--{{ section.settings.header_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="zigzag-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="zigzag-section__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="zigzag-section__intro rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="zigzag-section__rows">
        {%- for block in section.blocks -%}
          {%- liquid
            assign parity = forloop.index0 | modulo: 2
            if block.settings.image_position == 'auto' or block.settings.image_position == blank
              if section.settings.first_row_image_position == 'left'
                if parity == 0
                  assign resolved_image_position = 'left'
                else
                  assign resolved_image_position = 'right'
                endif
              else
                if parity == 0
                  assign resolved_image_position = 'right'
                else
                  assign resolved_image_position = 'left'
                endif
              endif
            else
              assign resolved_image_position = block.settings.image_position
            endif

            assign media_sizes = '(max-width: 749px) 100vw, 50vw'
            assign loading_strategy = 'lazy'
            if section.index == 1 and forloop.first
              assign loading_strategy = 'eager'
            endif
            assign image_alt = block.settings.image.alt | default: block.settings.heading | escape
          -%}

          <article
            class="zigzag-row zigzag-row--image-{{ resolved_image_position }} zigzag-row--valign-{{ section.settings.vertical_alignment }}"
            {{ block.shopify_attributes }}
          >
            <div class="zigzag-row__media zigzag-row__media--{{ section.settings.image_ratio }}">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1400
                  | image_tag:
                    loading: loading_strategy,
                    class: 'zigzag-row__img',
                    alt: image_alt,
                    widths: '400, 600, 800, 1000, 1200, 1400',
                    sizes: media_sizes
                }}
              {%- else -%}
                <div class="zigzag-row__placeholder">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="48"
                    height="48"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                  <span>{{ 'content.placeholder_image' | t }}</span>
                </div>
              {%- endif -%}
            </div>

            <div class="zigzag-row__content zigzag-row__content--{{ section.settings.content_alignment }}">
              {%- if block.settings.eyebrow != blank -%}
                <p class="zigzag-row__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              {%- endif -%}

              {%- if block.settings.heading != blank -%}
                <h3 class="zigzag-row__heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="zigzag-row__text rte">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- if block.settings.button_label != blank -%}
                <div class="zigzag-row__actions">
                  {%- if block.settings.button_link != blank -%}
                    <a
                      href="{{ block.settings.button_link }}"
                      class="{% if block.settings.button_style == 'secondary' %}button-secondary{% elsif block.settings.button_style == 'link' %}zigzag-row__link{% else %}button{% endif %}"
                    >
                      {{ block.settings.button_label | escape }}
                    </a>
                  {%- else -%}
                    <span
                      class="{% if block.settings.button_style == 'secondary' %}button-secondary{% elsif block.settings.button_style == 'link' %}zigzag-row__link{% else %}button{% endif %}"
                      aria-disabled="true"
                    >
                      {{ block.settings.button_label | escape }}
                    </span>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .zigzag-section__inner {
    width: 100%;
    min-width: 0;
  }

  .zigzag-section__inner--full-padded {
    padding-inline: var(--page-margin);
  }

  .zigzag-section__header {
    max-width: 48rem;
    margin-block-end: clamp(2rem, 4vw, 3.5rem);
  }

  .zigzag-section__header--center {
    margin-inline: auto;
    text-align: center;
  }

  .zigzag-section__header--left {
    margin-inline-end: auto;
    text-align: start;
  }

  .zigzag-section__header--right {
    margin-inline-start: auto;
    text-align: end;
  }

  .zigzag-section__eyebrow {
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: var(--font-size--xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / var(--opacity-70)));
    margin-block: 0 var(--margin-xs);
  }

  .zigzag-section__heading {
    font-family: var(--font-h2--family);
    font-style: var(--font-h2--style);
    font-weight: var(--font-h2--weight);
    font-size: var(--font-h2--size);
    line-height: var(--font-h2--line-height);
    letter-spacing: var(--font-h2--letter-spacing);
    text-transform: var(--font-h2--case);
    color: var(--color-foreground);
    margin-block: 0 var(--margin-md);
  }

  .zigzag-section__intro {
    font-family: var(--font-paragraph--family);
    font-size: var(--font-paragraph--size);
    line-height: 1.7;
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / var(--opacity-80)));
  }

  .zigzag-section__rows {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 4vw, var(--zigzag-row-gap, 56px));
  }

  .zigzag-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'media'
      'content';
    gap: clamp(1.5rem, 3vw, var(--zigzag-col-gap, 48px));
    align-items: center;
    min-width: 0;
  }

  @media screen and (min-width: 750px) {
    .zigzag-row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas: 'media content';
    }

    .zigzag-row--image-right {
      grid-template-areas: 'content media';
    }

    .zigzag-row--valign-flex-start {
      align-items: start;
    }

    .zigzag-row--valign-center {
      align-items: center;
    }

    .zigzag-row--valign-flex-end {
      align-items: end;
    }
  }

  .zigzag-row__media {
    grid-area: media;
    width: 100%;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--zigzag-image-radius, 12px);
    background-color: rgb(var(--color-foreground-rgb) / var(--opacity-5));
  }

  .zigzag-row__media--square {
    aspect-ratio: 1 / 1;
  }

  .zigzag-row__media--portrait {
    aspect-ratio: 4 / 5;
  }

  .zigzag-row__media--landscape {
    aspect-ratio: 4 / 3;
  }

  .zigzag-row__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--hover-transition-duration, 0.25s) var(--hover-transition-timing, ease-out);
  }

  .zigzag-row__media--auto .zigzag-row__img {
    height: auto;
  }

  @media (prefers-reduced-motion: no-preference) {
    .zigzag-row:hover .zigzag-row__img {
      transform: scale(1.02);
    }
  }

  .zigzag-row__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--gap-sm);
    min-height: 280px;
    height: 100%;
    padding: var(--padding-2xl);
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / var(--opacity-60)));
    text-align: center;
    font-size: var(--font-size--sm);
  }

  .zigzag-row__content {
    grid-area: content;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
  }

  .zigzag-row__content--left {
    align-items: flex-start;
    text-align: start;
  }

  .zigzag-row__content--center {
    align-items: center;
    text-align: center;
  }

  .zigzag-row__content--right {
    align-items: flex-end;
    text-align: end;
  }

  @media screen and (min-width: 750px) {
    .zigzag-row--image-left .zigzag-row__content {
      padding-inline-start: clamp(0rem, 2vw, 1.5rem);
    }

    .zigzag-row--image-right .zigzag-row__content {
      padding-inline-end: clamp(0rem, 2vw, 1.5rem);
    }
  }

  .zigzag-row__eyebrow {
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: var(--font-size--xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-foreground-muted, rgb(var(--color-foreground-rgb) / var(--opacity-70)));
    margin: 0;
  }

  .zigzag-row__heading {
    font-family: var(--font-h3--family);
    font-style: var(--font-h3--style);
    font-weight: var(--font-h3--weight);
    font-size: var(--font-h3--size);
    line-height: var(--font-h3--line-height);
    letter-spacing: var(--font-h3--letter-spacing);
    text-transform: var(--font-h3--case);
    color: var(--color-foreground);
    margin: 0;
  }

  .zigzag-row__text {
    font-family: var(--font-paragraph--family);
    font-size: var(--font-paragraph--size);
    line-height: 1.7;
    color: var(--color-foreground-subdued, rgb(var(--color-foreground-rgb) / var(--opacity-80)));
    max-width: 58ch;
  }

  .zigzag-row__actions {
    margin-block-start: var(--margin-xs);
  }

  .zigzag-row__link {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs);
    font-family: var(--font-subheading--family);
    font-weight: var(--font-subheading--weight);
    font-size: var(--font-size--sm);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    color: var(--color-foreground);
  }

  .zigzag-row__link:hover {
    color: rgb(var(--color-foreground-rgb) / var(--opacity-70));
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Zigzag image content",
  "class": "section-zigzag-image-content",
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Section header"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Who Are We?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "<p>ELOHA is a fashion brand crafted to celebrate effortless elegance, rich artisanal heritage, and modern comfort for every occasion.</p>"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Zigzag layout"
    },
    {
      "type": "select",
      "id": "first_row_image_position",
      "label": "First row image position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.image_ratio",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "range",
      "id": "image_corner_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "t:settings.position",
      "options": [
        {
          "value": "flex-start",
          "label": "t:options.top"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "flex-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row spacing",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "t:settings.gap",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "story_row",
      "name": "Story row",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "t:settings.media_position",
          "options": [
            {
              "value": "auto",
              "label": "Auto (alternating)"
            },
            {
              "value": "left",
              "label": "t:options.left"
            },
            {
              "value": "right",
              "label": "t:options.right"
            }
          ],
          "default": "auto"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Story Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:settings.text",
          "default": "<p>Share the craft, inspiration, and details behind this chapter of your brand story.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:settings.link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "t:settings.button_style",
          "options": [
            {
              "value": "primary",
              "label": "t:options.primary"
            },
            {
              "value": "secondary",
              "label": "t:options.secondary"
            },
            {
              "value": "link",
              "label": "t:options.link"
            }
          ],
          "default": "primary"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Zigzag image content",
      "category": "t:categories.storytelling",
      "blocks": [
        {
          "type": "story_row",
          "settings": {
            "heading": "Light On The Pocket",
            "text": "<p>We bring you the latest styles while staying pocket-friendly, so thoughtful fashion stays within everyone's reach.</p>"
          }
        },
        {
          "type": "story_row",
          "settings": {
            "heading": "Fashion Forward",
            "text": "<p>Born into style, our pieces balance modern silhouettes with lasting comfort so you feel confident every day.</p>"
          }
        },
        {
          "type": "story_row",
          "settings": {
            "heading": "Something For Everyone",
            "text": "<p>Whether it is a celebration, festive gathering, or an effortless everyday look, you will find something made for you.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
